# --- Database (Neon Postgres) -------------------------------------------------
# Pooled connection — what the app uses at runtime. Neon's dashboard calls this
# the "Pooled connection" string; it ends in `-pooler` before the region.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection — used only by `prisma migrate`, which cannot run DDL
# through the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# --- Seeding (prisma/seed.ts) -------------------------------------------------
SEED_ADMIN_EMAIL=admin@vltx.in
SEED_ADMIN_NAME="VLTX Admin"
SEED_ADMIN_PHONE=9633226916
SEED_ADMIN_PASSWORD=

# --- Defaults printed by the seed script --------------------------------------
DEFAULT_PIPELINE=
NEXT_PUBLIC_DEFAULT_PIPELINE=
DEFAULT_STAGE=
NEXT_PUBLIC_DEFAULT_STAGE=

# --- AI filter ----------------------------------------------------------------
AI_GATEWAY_API_KEY=
OPENAI_KEY=
AI_QUERY_DEBUG=false

# --- Email (password reset) ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Website valuation-form intake ---------------------------------------------
# Shared secret the website sends as the x-vltx-signature header when posting a
# submission to /api/webhooks/valuation. Generate with: openssl rand -hex 32
VALUATION_INTAKE_SECRET=
